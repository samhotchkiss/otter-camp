# PostgreSQL
POSTGRES_USER=ottercamp
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=ottercamp

# OtterCamp core
OTTERCAMP_MODE=production
OTTERCAMP_MASTER_KEY=replace_with_generated_value
OTTERCAMP_PORT=4110
OTTERCAMP_ADDR=:4110
OTTERCAMP_LOG_LEVEL=info
OTTERCAMP_LOG_FORMAT=json
OTTERCAMP_WORKER_CONCURRENCY=4
OTTERCAMP_AUTH_MODE=standard

# Database URL used by runtime services
OTTERCAMP_DATABASE_URL=postgres://ottercamp:changeme_in_production@postgres:5432/ottercamp?sslmode=disable
# Legacy alias
DATABASE_URL=${OTTERCAMP_DATABASE_URL}

# Storage
OTTERCAMP_STORAGE_BACKEND=fs
OTTERCAMP_STORAGE_ROOT=/app/data/objects
# Legacy aliases
OTTERCAMP_STORAGE_ADAPTER=filesystem
OTTERCAMP_STORAGE_PATH=/app/data/objects
# OTTERCAMP_S3_BUCKET=my-ottercamp-bucket
# OTTERCAMP_S3_ENDPOINT=https://s3.amazonaws.com

# Web assets
OTTERCAMP_WEB_DIR=/app/web/dist

# TLS
OTTERCAMP_TLS_MODE=none
# OTTERCAMP_TLS_ACME_DOMAIN=ottercamp.example.com
# OTTERCAMP_TLS_ACME_EMAIL=ops@example.com
# OTTERCAMP_TLS_CERT=/certs/fullchain.pem
# OTTERCAMP_TLS_KEY=/certs/privkey.pem

# Legacy TLS aliases
# OTTERCAMP_TLS_DOMAIN=ottercamp.example.com
# OTTERCAMP_TLS_CERT_FILE=/certs/fullchain.pem
# OTTERCAMP_TLS_KEY_FILE=/certs/privkey.pem
