---
import SEO from '@/components/SEO.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
}

const { title, description, image, type, publishedDate } = Astro.props;
const pageTitle = title === 'Home' ? 'sam.blog' : `${title} — sam.blog`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <SEO
      title={pageTitle}
      description={description}
      image={image}
      type={type}
      publishedDate={publishedDate}
    />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">sam.blog</a>
        <div>
          <a href="/blog">Blog</a>
          <a href="/photography">Photography</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} sam.blog</p>
    </footer>
  </body>
</html>

<style is:global>
  /* Minimal reset — design comes later */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: #1a1a1a;
    background: #fafafa;
  }

  body {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  header nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid #e0e0e0;
    margin-bottom: 2rem;
  }

  header nav a {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
  }

  header nav div {
    display: flex;
    gap: 1.5rem;
  }

  header nav a:hover {
    text-decoration: underline;
  }

  main {
    min-height: 60vh;
  }

  footer {
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid #e0e0e0;
    font-size: 0.875rem;
    color: #666;
  }

  a {
    color: #0066cc;
  }

  h1, h2, h3, h4, h5, h6 {
    line-height: 1.3;
    margin-bottom: 0.5em;
  }

  p {
    margin-bottom: 1em;
  }

  img {
    max-width: 100%;
    height: auto;
  }
</style>