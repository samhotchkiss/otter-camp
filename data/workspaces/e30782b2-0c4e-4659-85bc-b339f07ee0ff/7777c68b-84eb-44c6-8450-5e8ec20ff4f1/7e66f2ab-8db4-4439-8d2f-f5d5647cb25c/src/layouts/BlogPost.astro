---
import BaseLayout from '@/layouts/BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  date: Date;
  updatedDate?: Date;
  image?: string;
  tags?: string[];
}

const { title, description, date, updatedDate, image, tags } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} type="article" publishedDate={date.toISOString()}>
  <article>
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {updatedDate && (
          <span>
            (Updated: <time datetime={updatedDate.toISOString()}>
              {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>)
          </span>
        )}
      </div>
      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article header {
    margin-bottom: 2rem;
  }

  .meta {
    font-size: 0.875rem;
    color: #666;
    margin-top: 0.5rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    background: #e8e8e8;
    border-radius: 0.25rem;
    color: #555;
  }

  .prose :global(h2) {
    margin-top: 2rem;
  }

  .prose :global(pre) {
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose :global(code) {
    font-size: 0.875em;
  }

  .prose :global(blockquote) {
    border-left: 3px solid #ddd;
    padding-left: 1rem;
    color: #555;
    margin: 1.5rem 0;
  }
</style>