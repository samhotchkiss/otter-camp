---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<BaseLayout title="Home" description="sam.blog — writing, photography, and other things.">
  <section>
    <h1>sam.blog</h1>
    <p>Writing, photography, and other things.</p>
  </section>

  <section class="recent-posts">
    <h2>Recent Posts</h2>
    {posts.length > 0 ? (
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-title">{post.data.title}</span>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </a>
            {post.data.description && <p class="description">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <p>No posts yet. Check back soon!</p>
    )}
  </section>
</BaseLayout>

<style>
  section {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .recent-posts ul {
    list-style: none;
  }

  .recent-posts li {
    padding: 0.75rem 0;
    border-bottom: 1px solid #eee;
  }

  .recent-posts a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    gap: 1rem;
  }

  .recent-posts a:hover .post-title {
    text-decoration: underline;
  }

  .post-title {
    font-weight: 500;
  }

  time {
    font-size: 0.8125rem;
    color: #888;
    white-space: nowrap;
  }

  .description {
    font-size: 0.875rem;
    color: #666;
    margin-top: 0.25rem;
    margin-bottom: 0;
  }
</style>